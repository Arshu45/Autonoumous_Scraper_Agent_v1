{
  "brand": "Adidas Australia",
  "source_url": [
    {
      "url": "https://www.adidas.com.au/",
      "category_hint": "Global sportswear brand. Running, training, and lifestyle apparel. Clothing promotions -> Menswear. Shoes and sneakers -> Footwear. Student discounts (e.g. UNiDAYS) -> keep=true, categorise by product type mentioned."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "text",
  "text_selectors": [
    "[data-auto-id='banner-summary']",
    "[data-auto-id='banner-title']",
    "[data-auto-id='promo-messaging-bar'] p"
  ],
  "screenshot_selectors": [],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "use_stealth_headers": false,
  "use_webdriver_patch": false,
  "enabled": true
}