{
  "brand": "Toyworld",
  "source_url": [
    {
      "url": "https://www.toyworld.com.au/",
      "category_hint": "Toy store. Toys, board games, puzzles, action figures, LEGO -> Toys. Always Toys."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "screenshot",
  "text_selectors": [],
  "screenshot_selectors": [
    "[data-slide-link='/collections/offers'] img",
    ".brand-logos__image img"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}
