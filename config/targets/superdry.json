{
  "brand": "Superdry",
  "source_url": [
    {
      "url": "https://superdry.com.au/",
      "category_hint": "Casual streetwear, jackets, hoodies -> Menswear or Womens depending on context."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".topbar-item",
    "a[aria-label*='Off']",
    "a[aria-label*='for $']",
    "a[aria-label*='from $']",
    "[data-block-id*='__text_'] h1"
  ],
  "screenshot_selectors": [],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}
