{
  "brand": "Witchery",
  "source_url": [
    {
      "url": "https://www.witchery.com.au/",
      "category_hint": "Women's fashion, shoes, and accessories -> Womens. Always Womens."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    "div[class*='tw-max-w-[1440px]']",
    "div[class*='SignupFooter']",
    "a[href='/sale/']",
    "header",
    "[data-type='RichText'] p"
  ],
  "screenshot_selectors": [
    "div[class*='tw-max-w-[1440px]']",
    "[data-type='SignupFooter']"
  ],
  "cta_selectors": [
    "a[href='/sale/']",
    "a[href*='subscriber']"
  ],
  "exclude_selectors": [
    "nav",
    "footer",
    ".breadcrumb",
    ".cookie",
    ".newsletter input",
    ".search",
    ".logo"
  ],
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/favicon",
    "social",
    "payment",
    "brand-logo"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}
