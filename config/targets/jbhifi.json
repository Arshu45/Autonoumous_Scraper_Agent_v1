{
  "brand": "JB Hi-Fi",
  "source_url": [
    {
      "url": "https://www.jbhifi.com.au",
      "category_hint": "Australian consumer electronics and entertainment retailer. Laptops, computers, phones, TVs, gaming, audio, and tech accessories -> Entertainment. EPIC DEAL, COMPUTER SELLOUT, MONSTER DEAL, and BONUS OFFER promotions -> Entertainment. Always assign Entertainment for this brand."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",

  "text_selectors": [
    "a[aria-label='Hero Banner']",
    "a[aria-label='Promo Card']",

    "[data-testid='product-card-content']",
    ".ProductCard_content"
  ],

  "screenshot_selectors": [
    "div[data-gaip-type='carousel'] img",
    "a[aria-label='Hero Banner'] + img",
    "img[alt*='Big Brand']",
    "img[src*='Big_Brand_Sellout']",
    "a[aria-label='Promo Card']",

    "[data-testid='product-card-content']",
    ".ProductCard_content"
  ],

  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,

  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],

  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}