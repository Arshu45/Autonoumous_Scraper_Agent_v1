{
  "brand": "Forever New",
  "source_url": [
    {
      "url": "https://www.forevernew.com.au/sale",
      "category_hint": "Women's fashion brand only. All clothing, accessories, and sale promotions -> Womens. Loyalty reward membership signup offers (e.g. 'Join and get 10% off first full price purchase') -> keep=false. Standalone free delivery notices -> keep=false."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".header-banners",
    ".header-banner__link",
    ".header-banner__text",
    ".header-banner",
    "main h1",
    ".page-title",
    ".category-description",
    "[class*='newsletter']",
    "[class*='signup']",
    "[class*='sign-up']",
    ".block-newsletter"
  ],
  "screenshot_selectors": [
    "main a[href*='/sale']",
    ".hero-banner",
    "[class*='hero']",
    "[class*='banner']",
    "img.pagebuilder-desktop-only",
    "img.pagebuilder-mobile-only",
    "div[data-content-type='image']",
    "div[data-content-type='banner']",
    "[class*='pagebuilder']"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "request_delay_seconds": 4,
  "scroll_depth": 2,
  "enabled": true
}
