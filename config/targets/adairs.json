{
  "brand": "Adairs",
  "source_url": [
    {
      "url": "https://www.adairs.com.au",
      "category_hint": "Australian homewares, bedding, linen, furniture, and home decor retailer. All promotions always-> Home."
    }
  ],
  "category": "Home",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    "div[style*='font-weight: 200'][style*='font-size: 16px']",
    "h6[style*='font-size: 16px']"
  ],
  "screenshot_selectors": [
    "picture img",
    "img[src*='banner']",
    "img[src*='hero']",
    "img[src*='promo']",
    "img[src*='campaign']",
    "a img"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}
