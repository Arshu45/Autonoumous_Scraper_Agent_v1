{
  "brand": "Bed Bath N' Table",
  "source_url": [
    {
      "url": "https://www.bedbathntable.com.au",
      "category_hint": "Bedding, bath towels, homewares, tableware -> Home. Always assign Home for this brand."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".keyline__link"
  ],
  "screenshot_selectors": [
    "a[href='/sale'] img[data-element='desktop_image']"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}
