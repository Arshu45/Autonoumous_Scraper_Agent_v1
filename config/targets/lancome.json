{
  "brand": "Lancome",
  "source_url": [
    {
      "url": "https://www.lancome.com.au/",
      "category_hint": "Luxury skincare, makeup, and perfume -> Beauty. Always Beauty."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".c-content-tile__content:not(:has-text('JOIN NOW')):not(:has-text('LEARN MORE'))"
  ],
  "screenshot_selectors": [
    ".c-content-hero__image img"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 5,
  "enabled": true
}
