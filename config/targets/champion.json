{
  "brand": "Champion",
  "source_url": [
    {
      "url": "https://www.champion.com.au/",
      "category_hint": "Athletic apparel and streetwear. Hoodies, sweatshirts, track pants -> Menswear or Womens. Sneakers -> Footwear."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    "[data-block-id*='__text_'] h2",
    "[data-block-id*='__text_'] h3",
    "[data-block-id*='__text_'] h4",
    "[data-block-id*='__text_'] h5",
    "[data-block-id*='__text_'] h6",
    "[data-block-id*='__text_'] p",
    "[data-block-id*='__text_'] a",
    "[data-block-id*='__text_']"
  ],
  "screenshot_selectors": [
    "[class*='image_banner']",
    ".flickity-slider img",
    "img.mob-alt",
    "[class*='mob-alt']"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "promo_keywords_pattern": "\\d+\\s*%|\\boff\\b|\\bsale\\b|\\bdeal\\b|\\bsave\\b|\\bdiscount\\b|\\bextra\\b|free\\s+(?:[a-zA-Z]+\\s+)?(?:delivery|shipping|gift|returns?)|clearance|\\boffer\\b|\\bpromo(?:tion)?\\b|\\bcode\\b|\\bcoupon\\b|\\bvoucher\\b|\\bbogo\\b|buy\\s*\\d+\\s*get\\s*\\d+|\\b\\d+\\s*for\\s*\\d+\\b|[\\$£€¥₹]\\d+\\s+[A-Za-z]+",
  "enabled": true
}
