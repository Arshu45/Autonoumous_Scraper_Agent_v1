{
  "brand": "American Eagle",
  "source_url": [
    {
      "url": "https://americaneagle.com.au/",
      "category_hint": "Casual denim & apparel retailer. Women's products → Womens. Men's products → Menswear. If the promotion does not explicitly indicate gender, default to Menswear."
    }
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".group-block-content",
    ".ann-slide__text",
    ".ann-slide__text p"
  ],
  "screenshot_selectors": [
    ".ai-hero-banner",
    ".background-image-container",
    "[class*='hero-banner']",
    "[class*='group-block__media']"
  ],
  "min_image_width": 200,
  "min_image_height": 100,
  "min_aspect_ratio": 1.0,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}
